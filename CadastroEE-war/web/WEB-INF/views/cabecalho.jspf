<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Cadastro de produtos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</head>
<body class="container py-4">
<fmt:setLocale value="pt_BR"/>
<c:url var="controller" value="/ServletProdutoFC"/>
<header class="border-bottom mb-4 pb-3">
    <p class="text-secondary mb-1">CadastroEE · DGT2811</p>
    <h1 class="h2">Cadastro de produtos</h1>
</header>
<main>
<c:if test="${not empty erro}">
    <div class="alert alert-danger" role="alert"><c:out value="${erro}"/></div>
</c:if>
<c:if test="${not empty mensagem}">
    <div class="alert alert-success" role="status"><c:out value="${mensagem}"/></div>
</c:if>
